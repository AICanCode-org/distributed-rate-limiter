{
  "name": "rateguard-typescript",
  "version": "1.1.0",
  "description": "RateGuard distributed rate limiter - TypeScript/Node (Fastify) track (AiCanCode)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . && prettier --check \"src/**/*.ts\" \"test/**/*.ts\" && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fastify": "^5.12.5",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.2.7"
  }
}
