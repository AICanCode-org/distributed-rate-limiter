# Copy to .env (git-ignored) and adjust. docker compose reads .env automatically.
# Every track reads exactly these variables.

# --- app (used when you run a track directly on your machine with `make run`) ---
REDIS_URL=redis://localhost:6379/0
PORT=8080
# A Redis command that takes longer than this fails (the limiter then fails closed: 503).
REDIS_TIMEOUT_MS=1000
# LUA_DIR defaults to ../../spec/lua when run from tracks/<track> (/app/lua in the Docker images)

# --- admin API (Phase 3 M1) ---
# The bearer token of the admin API. Unset = a random token per process (admin API locked, dev only).
# Generate one with:  openssl rand -hex 32
ADMIN_TOKEN=local-admin-token-change-me-0123456789abcdef

# --- ports published by docker compose (change if something else uses them) ---
APP_PORT=8080
REDIS_PORT=6379
# the "pair" profile (two instances of one track for scripts/load-test.py)
TRACK=python
APP_A_PORT=8081
APP_B_PORT=8082

# --- AI policy advisor (Phase 3 M5). Default: offline rules, no key needed. ---
# Model names and free-tier limits change often: check the provider docs before you copy these.
AI_PROVIDER=offline
# Local + free + offline after the first download:   docker compose --profile ollama up -d
#   AI_PROVIDER=llm  LLM_BASE_URL=http://ollama:11434/v1  LLM_MODEL=llama3.2:1b
# Google Gemini free tier (OpenAI-compatible endpoint):
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  LLM_MODEL=gemini-2.0-flash
# Groq free tier:
#   LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:1b
LLM_API_KEY=
LLM_TIMEOUT_MS=5000
